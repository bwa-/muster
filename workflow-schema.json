{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://muster.giantswarm.io/schemas/workflow-v1alpha1.json",
  "title": "Muster Workflow",
  "description": "JSON Schema for Muster Workflow YAML files (v1alpha1)",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "muster.giantswarm.io/v1alpha1",
      "description": "API version for the Workflow resource"
    },
    "kind": {
      "type": "string",
      "const": "Workflow",
      "description": "Resource type (must be 'Workflow')"
    },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63,
          "description": "Unique name for the workflow"
        },
        "namespace": {
          "type": "string",
          "default": "default",
          "description": "Namespace for the workflow resource"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Labels for organizing workflows"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Annotations for additional metadata"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["steps"],
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Human-readable description of the workflow's purpose"
        },
        "args": {
          "type": "object",
          "description": "Argument definitions for workflow execution validation",
          "additionalProperties": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["string", "integer", "boolean", "number", "object", "array"],
                "description": "Expected data type for this argument"
              },
              "description": {
                "type": "string",
                "maxLength": 500,
                "description": "Explanation of the argument's purpose and usage"
              },
              "required": {
                "type": "boolean",
                "default": false,
                "description": "Whether this argument must be provided"
              },
              "default": {
                "description": "Default value if the argument is not specified"
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "description": "Sequence of workflow steps defining the execution flow",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$",
                "maxLength": 63,
                "description": "Unique identifier for this step within the workflow"
              },
              "description": {
                "type": "string",
                "maxLength": 500,
                "description": "Human-readable documentation for this step's purpose"
              },
              "tool": {
                "type": "string",
                "minLength": 1,
                "description": "Name of the tool to execute for this step (e.g., 'core_service_create', 'x_git_commit')"
              },
              "args": {
                "type": "object",
                "description": "Arguments for the tool execution (supports templating with {{.args.name}}, {{.results.step_id}}, {{.item}})",
                "additionalProperties": true
              },
              "store": {
                "type": "boolean",
                "default": false,
                "description": "Whether to store the step result for use in later steps via {{.results.step_id}}"
              },
              "allowFailure": {
                "type": "boolean",
                "default": false,
                "description": "Whether to continue to next step if this step fails"
              },
              "outputs": {
                "type": "object",
                "description": "How step results should be stored and made available to subsequent steps",
                "additionalProperties": true
              },
              "condition": {
                "type": "object",
                "description": "Optional condition that determines whether this step should execute",
                "properties": {
                  "tool": {
                    "type": "string",
                    "description": "Name of the tool to execute for condition evaluation"
                  },
                  "fromStep": {
                    "type": "string",
                    "description": "Reference a previous step ID for condition evaluation"
                  },
                  "args": {
                    "type": "object",
                    "description": "Arguments to pass to the condition tool",
                    "additionalProperties": true
                  },
                  "expect": {
                    "type": "object",
                    "description": "Positive expectations for the condition",
                    "properties": {
                      "success": {
                        "type": "boolean",
                        "description": "Whether the tool call should succeed"
                      },
                      "jsonPath": {
                        "type": "object",
                        "description": "JSON path conditions to check in the result",
                        "additionalProperties": true
                      }
                    }
                  },
                  "expectNot": {
                    "type": "object",
                    "description": "Negative expectations for the condition",
                    "properties": {
                      "success": {
                        "type": "boolean",
                        "description": "Whether the tool call should fail"
                      },
                      "jsonPath": {
                        "type": "object",
                        "description": "JSON path conditions that should NOT match",
                        "additionalProperties": true
                      }
                    }
                  }
                }
              },
              "forEach": {
                "type": "object",
                "required": ["items", "step"],
                "description": "Execute this step template for each item in a collection",
                "properties": {
                  "items": {
                    "description": "Collection to iterate over (can be array literal or template expression like '{{.args.names}}')"
                  },
                  "step": {
                    "type": "object",
                    "required": ["id", "tool"],
                    "description": "Step template to execute for each item (can reference {{.item}} or {{.item.field}})",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Unique identifier for this step template"
                      },
                      "description": {
                        "type": "string",
                        "description": "Documentation for the step template"
                      },
                      "tool": {
                        "type": "string",
                        "description": "Name of the tool to execute for each iteration"
                      },
                      "args": {
                        "type": "object",
                        "description": "Arguments for each iteration (can reference {{.item}})",
                        "additionalProperties": true
                      },
                      "store": {
                        "type": "boolean",
                        "default": false,
                        "description": "Whether each iteration's result should be stored"
                      },
                      "allowFailure": {
                        "type": "boolean",
                        "default": false,
                        "description": "Whether a single iteration is allowed to fail"
                      }
                    }
                  }
                }
              }
            },
            "oneOf": [
              {
                "required": ["tool"]
              },
              {
                "required": ["forEach"]
              }
            ]
          }
        }
      }
    },
    "status": {
      "type": "object",
      "description": "Observed state of the workflow (managed by muster)",
      "properties": {
        "available": {
          "type": "boolean",
          "description": "Whether all required tools for this workflow are available"
        },
        "requiredTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of all tools required by workflow steps"
        },
        "missingTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tools that are currently unavailable"
        },
        "stepValidation": {
          "type": "array",
          "description": "Validation results for each workflow step",
          "items": {
            "type": "object",
            "required": ["stepId", "valid", "toolAvailable"],
            "properties": {
              "stepId": {
                "type": "string",
                "description": "Workflow step identifier"
              },
              "valid": {
                "type": "boolean",
                "description": "Whether the step passed validation"
              },
              "toolAvailable": {
                "type": "boolean",
                "description": "Whether the required tool is available"
              },
              "validationErrors": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Validation error messages"
              }
            }
          }
        }
      }
    }
  }
}
